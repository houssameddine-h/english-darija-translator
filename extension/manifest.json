{
  "manifest_version": 3,
  "name": "Darija Translator",
  "version": "1.0",
  "description": "A simple extension to translate English to Darija using Gemini API.",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Darija Translator",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
